+    // psi backend, spicy or legacy.
+    // read from the PrivateDropPSIBackend user default, spicy if unset.
+    static var psiBackend: String {
+        UserDefaults.standard.string(forKey: "PrivateDropPSIBackend") ?? "spicy"
+    }
+
+    // spicy role mapping, identifiersAsSender or identifiersAsReceiver.
+    // read from the PrivateDropSpicyRoleMapping user default, identifiersAsSender if unset.
+    static var spicyRoleMapping: SpicyRoleMapping {
+        UserDefaults.standard.string(forKey: "PrivateDropSpicyRoleMapping")
+            .flatMap(SpicyRoleMapping.init(rawValue:)) ?? .identifiersAsSender
+    }
+
+    // spicy consistency level, cic or wic.
+    // read from the PrivateDropSpicyLevel user default, cic if unset.
+    static var spicyLevel: SpicyLevel {
+        UserDefaults.standard.string(forKey: "PrivateDropSpicyLevel")
+            .flatMap(SpicyLevel.init(rawValue:)) ?? .cic
+    }
+
+    // spicy settings from the bundled test identity for these identifiers.
+    // returns nil when the original psi is selected.
+    static func spicySettings(identifiers: [String]) -> SpicyPSISettings? {
+        guard psiBackend == "spicy" else { return nil }
+        let mapping = spicyRoleMapping
+        let role = mapping == .identifiersAsSender ? "sender" : "receiver"
+        let level = spicyLevel
+        let tag = level == .wic ? "spicy_wic" : "spicy"
+        let k = identifiers.count
+        let bundle = Bundle.main
+        guard
+            let signed = bundle.url(
+                forResource: "\(k)_\(tag)_\(role)", withExtension: "cms", subdirectory: "Identities"),
+            let secret = bundle.url(
+                forResource: "\(k)_\(tag)_\(role)_secret", withExtension: "bin", subdirectory: "Identities"),
+            let authority = bundle.url(forResource: "spicy-test-authority", withExtension: "pem")
+        else {
+            fatalError("No SPICy \(level.rawValue) identity for \(k) identifiers (LEVEL=\(level.rawValue) spicy/scripts/make-identity-resources.sh \(k))")
+        }
+        return SpicyPSISettings(
+            roleMapping: mapping, level: level, signedIdentity: try! Data(contentsOf: signed),
+            identitySecret: try! Data(contentsOf: secret), identifiers: identifiers,
+            authorityCertificatePEM: try! Data(contentsOf: authority))
+    }
+
     static func randomString(length: Int) -> String {
         let letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
         return String((0..<length).map { _ in letters.randomElement()! })
